# KFlow server
HOST=127.0.0.1
PORT=9000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 上线到 nginx 后端后设置：碎碎念视频/封面改由 X-Accel-Redirect 交给 nginx
# 直发，Django 只做校验。必须与 deploy/nginx-kflow.conf 里的 internal location
# 前缀一致；留空 = 走 Django 自带的 Range 流式（本地开发保持留空）。
# XACCEL_MEDIA_PREFIX=/_protected_uploads

# 上 HTTPS 后打开（需要 ALLOWED_HOSTS 一起配）：
# ALLOWED_HOSTS=example.com
# SESSION_COOKIE_SECURE=true
# CSRF_TRUSTED_ORIGINS=https://example.com

# Imaging cache lifetime; identical parameters remain private to one user.
IMAGING_CACHE_DAYS=30

# OpenAI-compatible image API. A bare origin is normalized to its /v1 API root.
CPA_BASE_URL=http://127.0.0.1:8317/v1
CPA_API_KEY=

# Optional Skill prompt compiler. Use a separate OpenAI-compatible text model
# when the image provider account cannot call chat/completions.
CPA_CHAT_BASE_URL=https://api.openai.com/v1
CPA_CHAT_API_KEY=
CPA_CHAT_MODEL=gpt-4o-mini
CPA_CHAT_TIMEOUT_SECONDS=180

# User verification email (generic SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace-with-mailbox-app-password
SMTP_FROM=KFlow <no-reply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
